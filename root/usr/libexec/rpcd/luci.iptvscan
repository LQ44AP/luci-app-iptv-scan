#!/usr/bin/ucode

let fs = require('fs');

let LOCK_FILE = '/tmp/iptv_scan.lock';
let LOG_FILE  = '/tmp/iptv_scan.log';
let SCAN_BIN  = '/usr/bin/iptv_scan.lua';

// 判断扫描任务是否运行中
function is_running() {
    let pid = null;

    // 读锁文件
    let f;
    try {
        f = fs.open(LOCK_FILE, 'r');
    } catch (e) {
        return false;
    }
    if (!f) return false;

    pid = f.read('all');
    f.close();

    if (!pid) return false;
    pid = replace(pid, /[^0-9]/g, '');
    if (!length(pid)) return false;

    // 通过 /proc/<pid> 是否存在判断进程存活
    try {
        let p = fs.open(`/proc/${pid}/stat`, 'r');
        if (p) {
            p.close();
            return true;
        }
    } catch (e) {
        return false;
    }
    return false;
}

// 读取日志尾部
function tail_log(max_bytes) {
    let f;
    try {
        f = fs.open(LOG_FILE, 'r');
    } catch (e) {
        return '';
    }
    if (!f) return '';

    let content = f.read('all');
    f.close();
    if (!content) return '';

    if (length(content) > max_bytes)
        content = substr(content, length(content) - max_bytes);
    return content;
}

let methods = {
    get_status: function() {
        return {
            running: is_running(),
            log: tail_log(65536)
        };
    },

    start_scan: function() {
        if (is_running())
            return { error: '扫描任务已在运行中' };

        system(`nohup ${SCAN_BIN} > ${LOG_FILE} 2>&1 &`);
        return { success: true };
    },

    list_interfaces: function() {
        let interfaces = [];
        let p = popen('ubus list "network.interface.*" 2>/dev/null');
        if (p) {
            let line;
            while ((line = p.read('line')) !== null) {
                let name = match(line, /^network\.interface\.(.+)$/);
                if (name && length(name) > 1)
                    push(interfaces, { name: name[1] });
            }
            p.close();
        }
        return { interfaces: interfaces };
    }
};

return {
    'luci.iptvscan': methods
};
